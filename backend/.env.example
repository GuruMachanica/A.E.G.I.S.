# =================================================================
# A.E.G.I.S Backend Environment Configuration Example
# Copy this file to .env and configure your values.
# =================================================================

# SMTP Configuration (for 2FA / OTP email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
OTP_FROM_EMAIL=A.E.G.I.S <no-reply@aegis-security.local>

# OTP Settings
OTP_EXPIRY_SEC=300
OTP_RATE_LIMIT=5
OTP_PEPPER=change-this-to-a-secure-random-string

# JWT Authentication
JWT_SECRET=your_32_character_minimum_random_secret_string
REFRESH_SECRET=your_32_character_minimum_random_refresh_secret
OTP_PEPPER=your_random_secret_pepper_string

# Optional Google OAuth Web Client ID
GOOGLE_CLIENT_ID=
REFRESH_TOKEN_TTL_SEC=2592000

# Server & Database Settings
CORS_ALLOW_ORIGINS=*
API_BASE_URL=http://127.0.0.1:8000
WS_URL=ws://127.0.0.1:8000/assist/live-audio
DATABASE_PATH=./aegis_backend.db

# ML / AASIST Fake Voice Model
VOICE_MODEL_PATH=
INTENT_MODEL_PATH=
ASSIST_FAKEVOICE_DIR=./app/ml/ASSIST-FAKEVOICE-DETECTION
ASSIST_TARGET_SAMPLE_RATE=16000

# Sarvam STT & NLP Threat Intelligence API
SARVAM_ENABLED=true
SARVAM_ENDPOINT=https://api.sarvam.ai/v1
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TIMEOUT_SEC=6
